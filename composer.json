{
    "name": "camalote-wp/models",
    "type": "library",
    "description": "CamaloteWP Models provides abstract base classes for registering WordPress content models (post types, taxonomies, metadata, blocks).",
    "license": "GPL-2.0-or-later",
    "authors": [
        {
            "name": "Martín García",
            "email": "tin.geka@gmail.com"
        }
    ],
    "require": {
        "php": "^8.2"
    },
    "require-dev": {
        "pestphp/pest": "^3.0",
        "brain/monkey": "^2.7",
        "yoast/phpunit-polyfills": "^4.0",
        "phpstan/phpstan": "^2.0",
        "laravel/pint": "^1.0",
        "szepeviktor/phpstan-wordpress": "^2.0",
        "captainhook/captainhook-phar": "^5.29"
    },
    "autoload": {
        "psr-4": {
            "CamaloteWP\\Models\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "pest",
        "stan": "php -d memory_limit=512M vendor/bin/phpstan analyse",
        "pint": "pint --test",
        "check": [
            "@stan",
            "@pint",
            "@test"
        ]
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "captainhook/captainhook-phar": true
        }
    }
}
