{
    "name": "camalote-wp/models",
    "type": "library",
    "description": "CamaloteWP Models provides abstract base classes for registering WordPress content models (post types, taxonomies, metadata, blocks).",
    "license": "GPL-2.0-or-later",
    "authors": [
        {
            "name": "Martín García",
            "email": "tin.geka@gmail.com"
        }
    ],
    "require": {
        "php": "^8.2"
    },
    "autoload": {
        "psr-4": {
            "CamaloteWP\\Models\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "composer test --working-dir tooling",
        "stan": "composer stan --working-dir tooling",
        "pint": "composer pint --working-dir tooling",
        "check": "composer check --working-dir tooling"
    }
}
