{
  "name": "et-models",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "build": "npm run build:fotoperiodismo",
    "build:fotoperiodismo": "npm run build:fotoperiodismo:blocks && npm run build:fotoperiodismo:admin",
    "build:fotoperiodismo:blocks": "wp-scripts build --source-path=./app/Definitions/Fotoperiodismo/blocks/src --output-path=./app/Definitions/Fotoperiodismo/blocks/build",
    "build:fotoperiodismo:admin": "wp-scripts build --source-path=./app/Definitions/Fotoperiodismo/assets/src/js/admin-page --output-path=./app/Definitions/Fotoperiodismo/assets/build/admin-page",
    "start": "npm run start:fotoperiodismo",
    "start:fotoperiodismo": "npm run start:fotoperiodismo:blocks && npm run start:fotoperiodismo:admin",
    "start:fotoperiodismo:blocks": "wp-scripts start --source-path=./app/Definitions/Fotoperiodismo/blocks/src --output-path=./app/Definitions/Fotoperiodismo/blocks/build",
    "start:fotoperiodismo:admin": "wp-scripts start --source-path=./app/Definitions/Fotoperiodismo/assets/src/js/admin-page --output-path=./app/Definitions/Fotoperiodismo/assets/build/admin-page"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/enfantterrible-ar/et-models.git"
  },
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/enfantterrible-ar/et-models/issues"
  },
  "homepage": "https://github.com/enfantterrible-ar/et-models#readme",
  "devDependencies": {
    "@wordpress/scripts": "^31.4.0"
  },
  "dependencies": {
    "@10up/block-components": "^1.22.1",
    "@wordpress/dataviews": "^12.0.0",
    "nanoid": "^5.1.6"
  }
}
